{
  "metadata": [
    {
      "src": [
        {
          "files": ["OptalCP.csproj"],
          "src": "."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": true,
      "properties": {
        "TargetFramework": "net9.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["index.md", "toc.yml"]
      }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "OptalCP C# API",
      "_appFooter": "OptalCP — Constraint Programming Solver",
      "_enableSearch": true
    }
  }
}
