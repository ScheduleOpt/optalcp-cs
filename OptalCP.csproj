<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 serves .NET Framework consumers. Compat.cs shims the
         framework APIs it lacks. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>OptalCP</PackageId>
    <Version>2026.11.0</Version>
    <Company>Optal SAS</Company>
    <Product>OptalCP</Product>
    <Description>C# API for OptalCP constraint programming solver</Description>
    <PackageTags>constraint-programming;optimization;scheduling;solver;operations-research</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/ScheduleOpt/optalcp-cs</RepositoryUrl>

    <!-- Package settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Enable latest Roslyn analyzers (API design, null safety, performance) -->
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- CS0419: Ambiguous cref on overloaded methods (harmless, compiler picks one) -->
    <NoWarn>CS0419</NoWarn>
  </PropertyGroup>

  <!-- netstandard2.0 has no in-box System.Text.Json -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <!-- Include README and LICENSE in package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Expose internals to the test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="OptalCP.Tests" />
  </ItemGroup>


</Project>
